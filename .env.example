# ─────────────────────────────────────────────────────────────
# AUREX LABS — environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# On Vercel: Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are embedded in the browser bundle at build time —
# never put secrets in them. Rebuild after changing them.
# ─────────────────────────────────────────────────────────────

# Canonical site URL (no trailing slash). Used for canonical tags, sitemap,
# robots.txt, Open Graph and JSON-LD. REQUIRED in production.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional legal/trading name shown in the footer copyright.
NEXT_PUBLIC_LEGAL_NAME=

# ── Public contact (leave empty to hide the related buttons/links) ──
NEXT_PUBLIC_CONTACT_EMAIL=
# International format, digits only or with +/spaces, e.g. +92 300 1234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi AUREX LABS, I'd like to discuss a new project.

# ── Studio social profiles (full https:// URLs; empty = hidden) ──
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_BEHANCE_URL=
NEXT_PUBLIC_DRIBBBLE_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=

# ── Founder profile ──
# Path under /public or an https URL allowed by next.config images settings.
NEXT_PUBLIC_FOUNDER_PORTRAIT=/images/founder-portrait.svg
NEXT_PUBLIC_FOUNDER_PORTRAIT_ALT=Portrait of Muhammad Hassan Munir, founder of AUREX LABS
NEXT_PUBLIC_FOUNDER_LINKEDIN_URL=
NEXT_PUBLIC_FOUNDER_GITHUB_URL=
NEXT_PUBLIC_FOUNDER_BEHANCE_URL=
NEXT_PUBLIC_FOUNDER_INSTAGRAM_URL=
NEXT_PUBLIC_FOUNDER_X_URL=

# ── Contact form email delivery (server-only secrets) ──
# resend | smtp | console   (console only logs, and is refused in production)
EMAIL_PROVIDER=console
# Where inquiries are delivered
CONTACT_TO_EMAIL=
# Sender on a domain verified with your provider, e.g. "AUREX LABS <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Resend (https://resend.com) — when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# SMTP (Google Workspace, Zoho, Brevo, Postmark, etc.) — when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587/STARTTLS (auto-detected when empty)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ── Optional: Cloudflare Turnstile spam protection ──
# Set BOTH to enable the widget and server verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Optional: Google Search Console HTML-tag verification ──
# Paste only the content="..." value from the meta tag.
GOOGLE_SITE_VERIFICATION=
